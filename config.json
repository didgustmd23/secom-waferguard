{
  "dataset_profile": "configs/datasets/secom.json",
  "threshold_policy": {
    "min_recall": 0.8,
    "max_reinspection_ratio": 0.4,
    "selection_rule": "min_reinspection",
    "on_infeasible": "report_only"
  },
  "experiment": {
    "random_state": 42,
    "default_threshold": 0.5,
    "pca_explained_variance": 0.9,
    "cross_validation": {
      "n_splits": 5,
      "n_repeats": 5
    }
  },
  "metrics": {
    "primary": [
      "average_precision",
      "recall"
    ],
    "secondary": [
      "precision",
      "f1",
      "roc_auc"
    ]
  },
  "feature_selection": {
    "reduction_policy": {
      "max_sensor_count": 20,
      "target_ap_loss_ratio": 0.2,
      "max_ap_loss_ratio": 0.3,
      "comparison_pairs": [
        ["xgboost_all", "xgboost_top_20"],
        ["xgboost_all", "xgboost_rf_top_20"],
        ["lightgbm_all", "lightgbm_top_20"],
        ["lightgbm_all", "lightgbm_rf_top_20"]
      ]
    },
    "top_k_feature_counts": [
      100,
      50,
      30,
      20,
      10
    ]
  },
  "models": {
    "baseline": "logistic_regression",
    "candidates": [
      "logistic_regression_l1",
      "rbf_svm",
      "random_forest",
      "lightgbm",
      "xgboost"
    ]
  }
}
