{
  "dataset_id": "secom",
  "input_path": "data/processed/secom_merged.csv",
  "columns": {
    "label": "label",
    "timestamp": "timestamp",
    "timestamp_format": "%d/%m/%Y %H:%M:%S"
  },
  "column_roles": {
    "id_columns": [],
    "group_columns": [],
    "excluded_feature_columns": []
  },
  "labels": {
    "negative": -1,
    "positive": 1
  },
  "feature_columns": {
    "selection": "prefix",
    "prefix": "sensor_"
  },
  "feature_types": {
    "categorical_columns": []
  },
  "quality_rules": {
    "missing_ratio_threshold": 0.5,
    "drop_zero_variance": true
  },
  "ingestion": {
    "adapter": "feature_metadata_pair",
    "sources": [
      {
        "name": "features",
        "path": "data/raw/secom.data",
        "read_csv_options": {
          "sep": "\\s+",
          "header": null
        }
      },
      {
        "name": "metadata",
        "path": "data/raw/secom_labels.data",
        "read_csv_options": {
          "sep": "\\s+",
          "header": null
        }
      }
    ],
    "adapter_options": {
      "feature_source": "features",
      "metadata_source": "metadata",
      "metadata_columns": ["label", "timestamp"]
    }
  }
}
